{
  "info": {
    "name": "User Management Service",
    "description": "Micronaut user-management API.\n\nRUN ORDER MATTERS: 'Log in' must run first \u2014 it captures the bearer token into the\n`accessToken` collection variable, which every other request inherits via collection-level\nauth. 'Create user' then stores `userId` and `newEmail` for the requests after it.\n\nPoint `baseUrl` at http://localhost:8080 (backend directly) or http://localhost:8081\n(through nginx, the same origin the SPA uses). Both serve these routes.\n\nSafe to run repeatedly: each run creates a user with a timestamped email.\n\n`opsUrl` is separate from `baseUrl` on purpose: nginx forwards only /api/, so /health and /prometheus must address the backend directly even when the rest of the collection runs through the proxy.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "opsUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "username",
      "value": "admin",
      "type": "string"
    },
    {
      "key": "password",
      "value": "admin123!",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    },
    {
      "key": "newEmail",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1 \u00b7 Auth",
      "item": [
        {
          "name": "Log in",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Exchanges the seeded operator credentials for an HS256 bearer token (1h). Stores it as `accessToken`."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('returns an access_token', () => pm.expect(b.access_token).to.be.a('string').and.not.empty);",
                  "pm.collectionVariables.set('accessToken', b.access_token);",
                  "console.log('token captured, ' + b.access_token.length + ' chars');"
                ]
              }
            }
          ]
        },
        {
          "name": "Log in \u2014 wrong password is 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"definitely-not-it\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Bad credentials must not leak whether the username exists."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2 \u00b7 Users",
      "item": [
        {
          "name": "Create user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/users",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Grace\",\n  \"lastName\": \"Hopper\",\n  \"email\": \"{{newEmail}}\",\n  \"phone\": \"555-0142\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Creates a user with a timestamped email so the collection can be re-run without colliding."
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Unique email per run, so re-running never trips the 409 uniqueness rule.",
                  "pm.collectionVariables.set('newEmail', 'postman.' + Date.now() + '@example.com');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test('server assigned an id', () => pm.expect(b.id).to.be.a('string').and.not.empty);",
                  "pm.test('echoes what we sent', () => pm.expect(b.email).to.eql(pm.collectionVariables.get('newEmail')));",
                  "pm.test('createdAt is an ISO-8601 string', () => pm.expect(b.createdAt).to.be.a('string').and.match(/^\\d{4}-\\d{2}-\\d{2}T/));",
                  "pm.collectionVariables.set('userId', b.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List users",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/users?page=0&size=20&sort=createdAt&direction=desc",
            "description": "Paged and sorted. `sort` accepts only firstName, lastName, email, createdAt, updatedAt."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('content is always an array', () => pm.expect(b.content).to.be.an('array'));",
                  "pm.test('carries paging metadata', () => { pm.expect(b.totalElements).to.be.a('number'); pm.expect(b.totalPages).to.be.a('number'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Search users",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/users?search=grace",
            "description": "Case-insensitive substring match across first name, last name and email."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('finds the user we just created', () => pm.expect(pm.response.json().totalElements).to.be.above(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get user by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/users/{{userId}}"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('returns the requested user', () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('userId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update user",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/users/{{userId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Grace\",\n  \"lastName\": \"Hopper-Murray\",\n  \"email\": \"{{newEmail}}\",\n  \"phone\": \"555-0199\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Full replace. Omitting `phone` clears it rather than leaving the old value."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('surname was replaced', () => pm.expect(b.lastName).to.eql('Hopper-Murray'));",
                  "pm.test('updatedAt moved past createdAt', () => pm.expect(new Date(b.updatedAt) >= new Date(b.createdAt)).to.be.true);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3 \u00b7 Error contract",
      "item": [
        {
          "name": "Duplicate email is 409",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/users",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Impostor\",\n  \"lastName\": \"Hopper\",\n  \"email\": \"{{newEmail}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Uniqueness is enforced by the ux_users_email_lower index, so it holds under concurrency."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 Conflict', () => pm.response.to.have.status(409));",
                  "pm.test('names the rule', () => pm.expect(pm.response.json().code).to.eql('EMAIL_ALREADY_EXISTS'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Unknown id is 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/users/00000000-0000-0000-0000-000000000000"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 Not Found', () => pm.response.to.have.status(404));",
                  "pm.test('typed error code', () => pm.expect(pm.response.json().code).to.eql('USER_NOT_FOUND'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Validation errors report every field at once",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/users",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "An empty body must not stop at the first invalid field."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('lists more than one field error', () => { const e = pm.response.json(); pm.expect(e.fieldErrors, JSON.stringify(e)).to.be.an('array'); pm.expect(e.fieldErrors.length).to.be.above(1); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Unknown sort field is 400, never SQL",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/users?sort=ssn",
            "description": "Sort fields come from an allow-list; an unknown one is rejected before it reaches the query builder."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('INVALID_PARAMETER', () => pm.expect(pm.response.json().code).to.eql('INVALID_PARAMETER'));"
                ]
              }
            }
          ]
        },
        {
          "name": "No token is 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/users",
            "auth": {
              "type": "noauth"
            },
            "description": "The intercept-url map is default-deny; only login, /health and the swagger paths are anonymous."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4 \u00b7 Operations",
      "item": [
        {
          "name": "Health (anonymous)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{opsUrl}}/health",
            "auth": {
              "type": "noauth"
            },
            "description": "Anonymous on purpose: this is what the container HEALTHCHECK and any orchestrator probes."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('status is UP', () => pm.expect(pm.response.json().status).to.eql('UP'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Prometheus metrics (requires token)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{opsUrl}}/prometheus",
            "description": "Operational endpoints are sensitive; unlike /health they need a bearer token."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('is a Prometheus exposition', () => pm.expect(pm.response.text()).to.include('# TYPE'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Metrics without a token is 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{opsUrl}}/prometheus",
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ],
      "description": "Management endpoints live on the backend itself. nginx proxies only /api/, so these use {{opsUrl}} rather than {{baseUrl}}."
    }
  ]
}